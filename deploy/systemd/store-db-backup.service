[Unit]
Description=Store Database Backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/store
Environment=PGPASSWORD=password
ExecStart=/usr/bin/pg_dump -h localhost -p 5432 -U postgres -Fc mydatabase -f /opt/store/backups/$(date +%Y-%m-%d_%H%M%S).dump
StandardOutput=journal
StandardError=journal