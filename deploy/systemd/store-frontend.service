[Unit]
Description=Store Frontend (Next.js)
After=network.target store-backend.service
Requires=store-backend.service

[Service]
Type=simple
User=pc
Group=staff
WorkingDirectory=/opt/store/nextjs-frontend
Environment=NODE_ENV=production
Environment=PATH=/opt/store/nextjs-frontend/node_modules/.bin:/usr/local/bin:/usr/bin:/bin
Environment=NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ExecStart=/opt/store/nextjs-frontend/node_modules/.bin/next start
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target