[Unit]
Description=Store Google Drive Backup Sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pc
Group=staff
WorkingDirectory=/opt/store
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/rclone sync /opt/store/backups gdrive:db-backups --config /home/pc/.config/rclone/rclone.conf
StandardOutput=journal
StandardError=journal